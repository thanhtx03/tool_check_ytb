{
  "manifest_version": 3,
  "name": "YouTube Channel Checker",
  "version": "1.0.0",
  "description": "Kiểm tra số lượng video YouTube kênh đăng trong ngày - dán link kênh và xem ngay!",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YouTube Channel Checker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "clipboardRead",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://youtu.be/*",
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
